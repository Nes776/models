			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791797252161</Id>
					<Name><![CDATA[setupPassenger]]></Name>
					<X>20</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Passenger]]></Type>
					</Parameter>
					<Body><![CDATA[ped.business = randomTrue(0.15);

Flight f = null;
int attempts = 0;

// Ищем рейс, время посадки на который еще не прошло.
// Ограничиваем цикл 100 попытками, чтобы модель не зависла.
do {
    f = flights.random();
    attempts++;
} while (f != null && dateToTime(f.departureTime) - boardingTime < time() && attempts < 100);

// Если подходящий рейс найден, назначаем его пассажиру
if (f != null) {
    ped.flight = f;
    f.passengers.add(ped);
} else {
    // Если рейсов нет или все они улетели, выводим сообщение в лог
    traceln("Внимание: не удалось найти подходящий рейс для пассажира!");
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791801873397</Id>
					<Name><![CDATA[startBoarding]]></Name>
					<X>860</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[flight]]></Name>
						<Type><![CDATA[Flight]]></Type>
					</Parameter>
					<Body><![CDATA[for (Passenger p: flight.passengers)
{
	pedWait.free(p);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791802009422</Id>
					<Name><![CDATA[planBoardings]]></Name>
					<X>860</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (Flight f : flights) {
    // 1. Преобразуем дату вылета в модельное время (в минуты или секунды)
    double departureTimeInModel = dateToTime(f.departureTime);
    
    // 2. Вычисляем, когда должна начаться посадка
    double boardingStartTime = departureTimeInModel - boardingTime;
    double timeUntilBoarding = boardingStartTime - time();

    if (timeUntilBoarding > 0) {
        // Посадка еще не началась. Планируем событие BoardingEvent через timeUntilBoarding единиц времени
        create_BoardingEvent(timeUntilBoarding, f);
    } else {
        // Время посадки уже наступило (или прошло). 
        // Немедленно разрешаем посадку для этого рейса!
        startBoarding(f);
        
        // Вычисляем время до вылета
        double timeUntilDeparture = departureTimeInModel - time();
        
        // Если самолет уже должен был улететь, отправляем событие вылета немедленно (timeout = 0)
        if (timeUntilDeparture < 0) {
            timeUntilDeparture = 0; 
        }
        
        create_DepartureEvent(timeUntilDeparture, f);
    }
}]]></Body>
				</Function>
			</Functions>
